# Copy to .env.local (never commit it). Same Supabase project as the Argos backend.

# Server-only: used by /api/onboarding to save the form. No NEXT_PUBLIC_ prefix, so Next.js
# never sends these to the browser. Same values as the backend's .env.local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, for the later dashboard pages (signed-in views). The onboarding form does not need them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ARGOS_BACKEND_URL=
